config VIDEO_MTK_ISP7X_SENINF
	tristate "MediaTek ISP7.x seninf CSI-2 receiver"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on VIDEO_DEV
	select MEDIA_CONTROLLER
	select VIDEO_V4L2_SUBDEV_API
	select V4L2_FWNODE
	help
	  Support for the seninf sensor interface of MediaTek ISP7.x camera
	  systems, such as the one in MT6878. Seninf receives MIPI CSI-2
	  data from the camera sensors and routes it to the capture units.

	  To compile this driver as a module, choose M here: the module
	  will be called mtk-seninf.

config VIDEO_MTK_ISP7X_CAMSV
	tristate "MediaTek ISP7.x CAMSV raw capture"
	depends on VIDEO_MTK_ISP7X_SENINF
	select VIDEOBUF2_DMA_CONTIG
	help
	  Support for the CAMSV capture units of MediaTek ISP7.x camera
	  systems, such as the one in MT6878. CAMSV writes the raw Bayer
	  frames received by seninf to memory without processing them.

	  To compile this driver as a module, choose M here: the module
	  will be called mtk-camsv.
